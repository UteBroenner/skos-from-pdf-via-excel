@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix concept_status: <http://publications.europa.eu/resource/authority/concept-status/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix euvoc: <http://publications.europa.eu/ontology/euvoc#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skosno: <https://data.norge.no/vocabulary/skosno#> .
@prefix svv: <http://example.org/vegvesen/vokabular/def#> .
@prefix xkos: <http://rdf-vocabulary.ddialliance.org/xkos#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

svv:CrossRowErrors a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "VT-CYCLE-BROADER: cycle in skos:broader" ;
            sh:prefixes svv:prefixes ;
            sh:select "SELECT $this WHERE { $this skos:broader+ $this . }" ],
        [ a sh:SPARQLConstraint ;
            sh:message "VT-CYCLE-PARTOF: cycle in xkos:isPartOf" ;
            sh:prefixes svv:prefixes ;
            sh:select "SELECT $this WHERE { $this xkos:isPartOf+ $this . }" ],
        [ a sh:SPARQLConstraint ;
            sh:message "VT-RELATED-CLASH: skos:related to a concept that is also on a broader/narrower path" ;
            sh:prefixes svv:prefixes ;
            sh:select """
            SELECT $this ?value WHERE {
              $this skos:related|^skos:related ?value .
              { $this skos:broader+ ?value } UNION { ?value skos:broader+ $this }
            }""" ] ;
    sh:targetClass skos:Concept .

svv:CrossRowWarnings a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "VT-T1-BROADER-NON-T1: Tier 1 concept has a broader concept that is not Tier 1" ;
            sh:prefixes svv:prefixes ;
            sh:select """
            SELECT $this ?value WHERE {
              $this svv:tier 1 ; skos:broader ?value .
              ?value a skos:Concept .
              FILTER NOT EXISTS { ?value svv:tier 1 }
            }""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "VT-T1-ISOLATED: Tier 1 concept has no broader, isPartOf or related link (in or out)" ;
            sh:prefixes svv:prefixes ;
            sh:select """
            SELECT $this WHERE {
              $this svv:tier 1 .
              FILTER NOT EXISTS {
                $this skos:broader|xkos:isPartOf|skos:related|^skos:broader|^xkos:isPartOf|^skos:related ?x .
                ?x a skos:Concept .
              }
            }""" ] ;
    sh:targetClass skos:Concept .

svv:MainLanguageShape a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "VT-REQ-DEF: no definition in the main language" ;
            sh:prefixes svv:prefixes ;
            sh:select """
            SELECT $this WHERE {
              OPTIONAL { $this skos:inScheme/svv:mainLanguage ?ml }
              BIND (LCASE(COALESCE(STR(?ml), "nb")) AS ?lang)
              FILTER NOT EXISTS { $this skos:definition ?d . FILTER (LCASE(LANG(?d)) = ?lang) }
            }""" ],
        [ a sh:SPARQLConstraint ;
            sh:message "VT-REQ-LABEL: no prefLabel in the main language" ;
            sh:prefixes svv:prefixes ;
            sh:select """
            SELECT $this WHERE {
              OPTIONAL { $this skos:inScheme/svv:mainLanguage ?ml }
              BIND (LCASE(COALESCE(STR(?ml), "nb")) AS ?lang)
              FILTER NOT EXISTS { $this skos:prefLabel ?l . FILTER (LCASE(LANG(?l)) = ?lang) }
            }""" ] ;
    sh:targetClass skos:Concept .

skos:ConceptScheme a sh:NodeShape ;
    rdfs:comment "One vocabulary = one Excel workbook (vokabular sheet, rows 1-16)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype rdf:langString ;
            sh:languageIn ( "nb" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dct:title ],
        [ sh:datatype xsd:string ;
            sh:description "BCP 47 tag of the language in which every concept must have a prefLabel and a definition (scheme row \"hovedspråk\"; default nb). Enforced by SHACL (shapes/cross_row.shacl.ttl)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path svv:mainLanguage ],
        [ sh:datatype xsd:date ;
            sh:description "System-generated at publication." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dct:issued ],
        [ sh:description "Concept or scheme URI. For concepts built as <scheme URI>/<identifier> (v8 column B formula)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path svv:uri ],
        [ sh:datatype xsd:string ;
            sh:description "System-generated at publication." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dct:publisher ],
        [ sh:datatype xsd:string ;
            sh:description "Short name of the vocabulary, max 4 letters or digits (cell B12)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path svv:kortnavn ;
            sh:pattern "^[A-Za-z0-9]{1,4}$" ],
        [ sh:class skos:Concept ;
            sh:description "Container slot for the data file only. Not written to RDF; the RDF writer emits skos:inScheme on each concept instead." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path svv:concepts ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dct:creator ] ;
    sh:targetClass skos:ConceptScheme .

svv:prefixes sh:declare [ sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ;
            sh:prefix "skos" ],
        [ sh:namespace "http://rdf-vocabulary.ddialliance.org/xkos#"^^xsd:anyURI ;
            sh:prefix "xkos" ],
        [ sh:namespace "http://example.org/vegvesen/vokabular/def#"^^xsd:anyURI ;
            sh:prefix "svv" ] .

skos:Concept a sh:NodeShape ;
    rdfs:comment "One row in the vokabular sheet (row 23 onwards)." ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:name "pref_label_nn" ;
            sh:path skos:prefLabel ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:languageIn ( "nn" ) ] ],
        [ sh:name "created_by" ;
            sh:path dct:contributor ;
            sh:pattern "^[^@\\s]+@vegvesen\\.no$" ],
        [ sh:name "pref_label_en_gb" ;
            sh:path skos:prefLabel ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:languageIn ( "en-GB" ) ] ],
        [ sh:name "alt_label_es" ;
            sh:path skos:altLabel ],
        [ sh:languageIn ( "nb" "en" "nn" "en-US" "en-GB" "de" "es" ) ;
            sh:path skos:prefLabel ],
        [ sh:name "modified_by" ;
            sh:path dct:contributor ;
            sh:pattern "^[^@\\s]+@vegvesen\\.no$" ],
        [ sh:name "pref_label_en" ;
            sh:path skos:prefLabel ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:languageIn ( "en" ) ;
                    sh:not [ sh:languageIn ( "en-US" "en-GB" ) ] ] ],
        [ sh:name "definition_nb" ;
            sh:path skos:definition ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:languageIn ( "nb" ) ] ],
        [ sh:name "alt_label_en_gb" ;
            sh:path skos:altLabel ],
        [ sh:name "alt_label_en_us" ;
            sh:path skos:altLabel ],
        [ sh:name "alt_label_de" ;
            sh:path skos:altLabel ],
        [ sh:name "definition_en_us" ;
            sh:path skos:definition ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:languageIn ( "en-US" ) ] ],
        [ sh:name "alt_label_en" ;
            sh:path skos:altLabel ],
        [ sh:name "pref_label_nb" ;
            sh:path skos:prefLabel ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:languageIn ( "nb" ) ] ],
        [ sh:languageIn ( "nb" "en" "nn" "en-US" "en-GB" "de" "es" ) ;
            sh:path skos:altLabel ],
        [ sh:name "definition_nn" ;
            sh:path skos:definition ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:languageIn ( "nn" ) ] ],
        [ sh:name "pref_label_en_us" ;
            sh:path skos:prefLabel ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:languageIn ( "en-US" ) ] ],
        [ sh:name "definition_en" ;
            sh:path skos:definition ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:languageIn ( "en" ) ;
                    sh:not [ sh:languageIn ( "en-US" ) ] ] ],
        [ sh:name "pref_label_de" ;
            sh:path skos:prefLabel ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:languageIn ( "de" ) ] ],
        [ sh:name "alt_label_nb" ;
            sh:path skos:altLabel ],
        [ sh:languageIn ( "nb" "en" "nn" "en-US" ) ;
            sh:path skos:definition ],
        [ sh:name "pref_label_es" ;
            sh:path skos:prefLabel ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:languageIn ( "es" ) ] ],
        [ sh:maxCount 2 ;
            sh:path dct:contributor ],
        [ sh:name "alt_label_nn" ;
            sh:path skos:altLabel ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path adms:versionNotes ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 26 ;
            sh:path dcat:contactPoint ;
            sh:pattern "^[^@\\s]+@vegvesen\\.no$" ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path dct:modified ],
        [ sh:datatype rdf:langString ;
            sh:languageIn ( "nb" ) ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path skosno:relationRole ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path skos:editorialNote ],
        [ sh:class skos:Concept ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path xkos:isPartOf ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path skos:example ],
        [ sh:description "Concept or scheme URI. For concepts built as <scheme URI>/<identifier> (v8 column B formula)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path svv:uri ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path euvoc:endDate ],
        [ sh:datatype rdf:langString ;
            sh:description "Discouraged term, e.g. a common misspelling."@nb ;
            sh:languageIn ( "nb" ) ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path skos:hiddenLabel ],
        [ sh:datatype rdf:langString ;
            sh:languageIn ( "nb" ) ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path skos:scopeNote ],
        [ sh:class skos:Concept ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path skos:broader ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path skosno:dataStructureLabel ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path skos:notation ],
        [ sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path skos:exactMatch ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dct:source ],
        [ sh:datatype rdf:langString ;
            sh:description "Subject area. Template allows rdf:langString or skos:Concept; modelled as text for now."@nb ;
            sh:languageIn ( "nb" ) ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path dct:subject ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path skosno:valueRange ],
        [ sh:description "Set by the converter from the scheme URI." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 48 ;
            sh:path skos:inScheme ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path owl:versionInfo ],
        [ sh:in ( concept_status:CANDIDATE concept_status:CURRENT concept_status:DEPRECATED concept_status:RETIRED ) ;
            sh:maxCount 1 ;
            sh:order 33 ;
            sh:path euvoc:status ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path dct:audience ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 27 ;
            sh:path dct:created ],
        [ sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path skos:closeMatch ],
        [ sh:datatype xsd:date ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 34 ;
            sh:path euvoc:startDate ],
        [ sh:datatype xsd:integer ;
            sh:description "1 = physical objects, spatial concepts, measurable properties; 2 = processes and states; 3 = normative requirements. Only Tier 1 becomes OWL classes." ;
            sh:maxCount 1 ;
            sh:maxInclusive 3 ;
            sh:minInclusive 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 38 ;
            sh:path svv:tier ],
        [ sh:class skos:Concept ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path skos:related ],
        [ sh:datatype xsd:string ;
            sh:description "Internal ID <kortnavn>-NNNN. Relations in Excel refer to this ID." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dct:identifier ;
            sh:pattern "^[A-Za-z0-9]{1,4}-\\d{4}$" ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path skosno:relationshipWithSource ] ;
    sh:targetClass skos:Concept .

