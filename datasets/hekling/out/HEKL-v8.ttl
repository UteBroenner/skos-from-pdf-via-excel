    skos:broader vokdata:DoubleCrochet ;
    skos:definition "pair of double crochets in which the second is worked in front of or behind the first into a skipped stitch, so that they cross"@en-US,
        "par av staver der den andre hekles foran eller bak den første i en maske som er hoppet over, slik at stavene krysser hverandre"@nb ;
    skos:editorialNote "[usikker] de, es: termer ikke verifisert" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "gekreuztes Stäbchen"@de,
        "crossed treble crochet"@en-GB,
        "crossed double crochet"@en-US,
        "punto alto cruzado"@es,
        "krysset stav"@nb ;
    skos:scopeNote "Caution: 'crossed double crochet' is the US name of this concept and the US name of CrossedDoubleCrochet2. 'crossed treble crochet' is the UK name of this concept and the UK name of CrossedDoubleCrochet2 (crossed double crochet)."@en-US ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:DoubleTrebleCrochet a skos:Concept ;
