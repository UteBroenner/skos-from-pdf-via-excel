vokdata:MiniButterflyStitch a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-MiniButterflyStitch" ;
    dct:source <https://theunraveledmitten.com/2022/10/05/2022-stash-busting-crochet-along-part-9/> ;
    dct:subject "hekling"@nb ;
    skos:broader vokdata:StitchPattern ;
    skos:definition "stitch pattern in which chain loops are gathered in the middle by a single crochet worked from a later row, forming small butterfly shapes between groups of single crochets and double crochets"@en-US,
        "mønster der buer av luftmasker samles på midten med en fastmaske i en rad lenger opp, slik at det dannes små sommerfuglformer mellom grupper av fastmasker og staver"@nb ;
    skos:editorialNote "[omskrivning] definisjon utledet av mønsterbeskrivelsen i kilden; [mangler] nb, de, es: ingen etablert term kjent" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "mini butterfly stitch"@en-GB,
        "mini butterfly stitch"@en-US ;
    dcat:contactPoint "https://github.com/UteBroenner" .

