vokdata:TrebleCrochet a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-TrebleCrochet" ;
    dct:subject "hekling"@nb ;
    xkos:isPartOf vokdata:LazyWaveStitch,
        vokdata:NubbyCrochetStitch,
        vokdata:WaveAndChevron ;
    skos:altLabel "DStb"@de,
        "dtr"@en-GB,
        "tr"@en-US,
        "treble"@en-US,
        "pad"@es,
        "dobbel stav"@nb,
        "dst"@nb ;
    skos:broader vokdata:Stitch ;
    skos:definition "stitch made with two yarn overs before inserting the hook; the yarn is pulled up and drawn through two loops at a time, three times"@en-US,
        "maske der det lages to kast før nålen stikkes inn i arbeidet; garnet hentes opp og trekkes gjennom to og to løkker, tre ganger"@nb ;
    skos:editorialNote "[usikker] es: forkortelse «pad»" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "Doppelstäbchen"@de,
        "double treble crochet"@en-GB,
        "treble crochet"@en-US,
        "punto alto doble"@es,
        "dobbelstav"@nb ;
    skos:scopeNote "Caution: 'double treble crochet' is the UK name of this concept and the US name of DoubleTrebleCrochet. 'dtr' is the UK abbreviation of this concept and the US abbreviation of DoubleTrebleCrochet (double treble crochet). 'tr' is the US abbreviation of this concept and the UK abbreviation of DoubleCrochet (double crochet). 'treble crochet' is the US name of this concept and the UK name of DoubleCrochet (double crochet)."@en-US ;
    dcat:contactPoint "https://github.com/UteBroenner" .

