vokdata:CrossedCableStitch a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-CrossedCableStitch" ;
    dct:source <https://theunraveledmitten.com/2022/11/01/2022-crochet-along-part-10/> ;
    dct:subject "hekling"@nb ;
    skos:broader vokdata:StitchPattern ;
    skos:definition "stitch pattern in which a long double crochet is worked into a skipped stitch across the front of three double crochets, forming crossed cables, with rows of single crochets in between"@en-US,
        "mønster der en lang stav hekles i en maske som er hoppet over, foran tre staver, slik at det dannes kryssede kabler; veksler med rader med fastmasker"@nb ;
    skos:editorialNote "[omskrivning] definisjon utledet av mønsterbeskrivelsen i kilden; [mangler] nb, de, es: ingen etablert term kjent; Kilden sier mønsteret ligner crossed double crochet (CrossedDoubleCrochet), men krysser over tre staver; «long dc» er ikke laget som eget begrep" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "crossed cable stitch"@en-GB,
        "crossed cable stitch"@en-US ;
    skos:related vokdata:CrossedDoubleCrochet ;
    dcat:contactPoint "https://github.com/UteBroenner" .

