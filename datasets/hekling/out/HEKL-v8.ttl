    skos:broader vokdata:StitchPattern ;
    skos:definition "stitch pattern of V-stitches in which each V-stitch is worked into a double crochet of the row below instead of into the chain space, so that the Vs are offset"@en-US,
        "mønster av V-masker der hver V-maske hekles i en stav i raden under i stedet for i luftmaskebuen, slik at V-ene forskyves"@nb ;
    skos:editorialNote "[omskrivning] definisjon utledet av mønsterbeskrivelsen i kilden; [mangler] nb, de, es: ingen etablert term kjent" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "offset V-stitch"@en-GB,
        "offset V-stitch"@en-US ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:RaisedHerringbone a skos:Concept ;
