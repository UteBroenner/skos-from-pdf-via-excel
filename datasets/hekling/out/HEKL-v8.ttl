vokdata:PopcornStitch a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-PopcornStitch" ;
    dct:subject "hekling"@nb ;
    skos:altLabel "pc"@en-GB,
        "pc"@en-US ;
    skos:broader vokdata:Stitch ;
    skos:definition "stitch in which several complete double crochets are worked into the same stitch, after which the hook is drawn through the first of them so that the group folds together and closes"@en-US,
        "maske der flere fullførte staver hekles i samme maske, hvoretter nålen føres gjennom den første staven slik at gruppen foldes sammen og lukkes"@nb ;
    skos:editorialNote "Kilden (Part 9) har et mønsteravsnitt «Popcorn Stitch» med popcornmasker mellom halvstaver; ikke eget mønsterbegrep" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "Popcornmasche"@de,
        "popcorn stitch"@en-GB,
        "popcorn stitch"@en-US,
        "punto palomita"@es,
        "popcornmaske"@nb ;
    skos:related vokdata:Bobble ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:PuffStitch a skos:Concept ;
