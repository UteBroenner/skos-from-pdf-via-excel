vokdata:SiltStitch a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-SiltStitch" ;
    dct:source <https://theunraveledmitten.com/2022/07/12/2022-stash-busting-crochet-along-part-6/> ;
    dct:subject "hekling"@nb ;
    skos:broader vokdata:StitchPattern ;
    skos:definition "stitch pattern in which a row of groups of one single crochet and two double crochets lies between rows of double crochets"@en-US,
        "mønster der en rad med grupper av én fastmaske og to staver ligger mellom rader med staver"@nb ;
    skos:editorialNote "[omskrivning] definisjon utledet av mønsterbeskrivelsen i kilden; [mangler] nb, de, es: ingen etablert term kjent; Kilden nevner mønsteret bare som grunnlag for modified silt stitch; [usikker] gruppene (sc, 2 dc) med to masker hoppet over hekles som i sedge stitch (SedgeStitch), mulig samme mønster med to navn" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "silt stitch"@en-GB,
        "silt stitch"@en-US ;
    dcat:contactPoint "https://github.com/UteBroenner" .

