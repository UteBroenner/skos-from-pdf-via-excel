        "st"@en-GB,
        "st"@en-US,
        "p"@es,
        "m"@nb ;
    skos:definition "basic unit of crochet, formed by drawing the yarn through one or more loops on the hook"@en-US,
        "grunnenhet i hekling, dannet ved at garnet trekkes gjennom én eller flere løkker på heklenålen"@nb ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
