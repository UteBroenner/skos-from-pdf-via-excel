vokdata:PikeStitch a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-PikeStitch" ;
    dct:source <https://theunraveledmitten.com/2022/08/06/2022-crochet-along-part-7/> ;
    dct:subject "hekling"@nb ;
    skos:broader vokdata:StitchPattern ;
    skos:definition "stitch pattern of alternating extended single crochets and chains in which the extended single crochets are worked into the stitches of the row below, giving a loose mesh"@en-US,
        "mønster av vekselvis forlenget fastmaske og luftmaske, der de forlengede fastmaskene hekles i maskene i raden under; gir et løst nett"@nb ;
    skos:editorialNote "[omskrivning] definisjon utledet av mønsterbeskrivelsen i kilden; [mangler] nb, de, es: ingen etablert term kjent; Kilden sier mønsteret ligner linen stitch (MossStitch), men hekles i maskene i stedet for i luftmaskebuene" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "pike stitch"@en-GB,
        "pike stitch"@en-US ;
    skos:related vokdata:MossStitch ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:SedgeStitch a skos:Concept ;
