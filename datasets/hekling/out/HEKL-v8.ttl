vokdata:ArcadeStitch a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-ArcadeStitch" ;
    dct:source <https://theunraveledmitten.com/2022/01/25/2022-stash-busting-crochet-along/> ;
    dct:subject "hekling"@nb ;
    skos:broader vokdata:StitchPattern ;
    skos:definition "stitch pattern of single crochets and three-chain spaces in which a shell of five double crochets is worked into each space in the following row, forming arches"@en-US,
        "mønster av fastmasker og buer på tre luftmasker der det i neste rad hekles en vifte på fem staver i hver bue, slik at det dannes arkader"@nb ;
    skos:editorialNote "[omskrivning] definisjon utledet av mønsterbeskrivelsen i kilden; [mangler] nb, de, es: ingen etablert term kjent" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "arcade stitch"@en-GB,
        "arcade stitch"@en-US ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:Cluster a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-Cluster" ;
    dct:subject "hekling"@nb ;
    skos:altLabel "cl"@en-GB,
        "cl"@en-US ;
    skos:broader vokdata:Stitch ;
    skos:definition "stitch in which several incomplete stitches are worked and then finished together at the top in one movement"@en-US,
        "maske der flere ufullførte masker hekles og deretter avsluttes sammen øverst i ett trekk"@nb ;
    skos:editorialNote "[usikker] nb: «klynge»; de: «Büschelmasche» brukes også om puffmaske; [mangler] es" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "Büschelmasche"@de,
        "cluster"@en-GB,
        "cluster"@en-US,
        "klynge"@nb ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:Decrease a skos:Concept ;
    svv:tier 2 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-Decrease" ;
    dct:subject "hekling"@nb ;
    skos:altLabel "dec"@en-GB,
        "dec"@en-US,
        "dism"@es ;
    skos:definition "joining two or more stitches into one, so that the stitch count decreases"@en-US,
        "det å slå sammen to eller flere masker til én, slik at maskeantallet minker"@nb ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "Abnahme"@de,
        "decrease"@en-GB,
        "decrease"@en-US,
        "disminución"@es,
        "felling"@nb ;
    skos:related vokdata:Increase ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:WaveAndChevron a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-WaveAndChevron" ;
    dct:source <https://theunraveledmitten.com/2022/01/25/2022-stash-busting-crochet-along/> ;
    dct:subject "hekling"@nb ;
    skos:broader vokdata:StitchPattern ;
    skos:definition "two-colour stitch pattern in which rows of stitches of rising and falling height form waves, and rows of single crochets with increases and decreases form chevrons"@en-US,
        "mønster i to farger der rader med masker i stigende og synkende høyde danner bølger, og rader med fastmasker med økninger og fellinger danner sikksakk"@nb ;
    skos:editorialNote "[omskrivning] definisjon utledet av mønsterbeskrivelsen i kilden; [mangler] nb, de, es: ingen etablert term kjent" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "wave and chevron"@en-GB,
        "wave and chevron"@en-US ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:Stitch a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
