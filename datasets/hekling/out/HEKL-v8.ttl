@prefix concept_status: <http://publications.europa.eu/resource/authority/concept-status/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix euvoc: <http://publications.europa.eu/ontology/euvoc#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix svv: <http://example.org/vegvesen/vokabular/def#> .
@prefix vokdata: <http://example.org/vegvesen/vokabular/crochet-us/> .
@prefix xkos: <http://rdf-vocabulary.ddialliance.org/xkos#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

vokdata:ChainSpace a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-ChainSpace" ;
    dct:source <https://theunraveledmitten.com/2022/01/25/2022-stash-busting-crochet-along/> ;
    dct:subject "hekling"@nb ;
    xkos:isPartOf vokdata:ArcadeStitch,
        vokdata:HappyHearts,
        vokdata:IrisStitch,
        vokdata:MiniButterflyStitch,
        vokdata:SlantedSpikeStitch,
        vokdata:TrinityStitch,
        vokdata:WattleStitch,
        vokdata:ZigZagLozengeStitch ;
    skos:altLabel "Lm-Bogen"@de,
        "ch-sp"@en-GB,
        "ch sp"@en-US,
        "ch-sp"@en-US,
        "espacio de cadenetas"@es,
        "lm-bue"@nb ;
    skos:definition "opening beneath one or more chains of the previous row, worked into instead of into a stitch"@en-US,
        "åpning under én eller flere luftmasker i raden under, som det hekles inn i i stedet for i en maske"@nb ;
    skos:editorialNote "[usikker] es" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "Luftmaschenbogen"@de,
        "chain space"@en-GB,
        "chain space"@en-US,
        "arco de cadenetas"@es,
        "luftmaskebue"@nb ;
    skos:related vokdata:Chain ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:DoubleCrochetThreeTogether a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-DoubleCrochetThreeTogether" ;
    dct:source <https://theunraveledmitten.com/2022/01/25/2022-stash-busting-crochet-along/> ;
    dct:subject "hekling"@nb ;
    xkos:isPartOf vokdata:ZigZagLozengeStitch ;
    skos:altLabel "tr3tog"@en-GB,
        "dc3tog"@en-US ;
    skos:broader vokdata:Cluster ;
    skos:definition "cluster in which three incomplete double crochets are worked into the same stitch or chain space and finished together in one movement"@en-US,
        "klynge der tre ufullførte staver hekles i samme maske eller luftmaskebue og avsluttes sammen i ett trekk"@nb ;
    skos:editorialNote "Kilden kaller masken «Cluster Stitch» og hekler alle tre i samme bue; brukes andre steder også som felling over tre masker" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "3 Stäbchen zusammen abmaschen"@de,
        "treble crochet three together"@en-GB,
        "double crochet three together"@en-US,
        "3 puntos altos juntos"@es,
        "3 staver sammen"@nb ;
    skos:related vokdata:DoubleCrochetTwoTogether ;
    skos:scopeNote "Caution: 'dc3tog' is the US abbreviation of this concept and the UK abbreviation of SingleCrochetThreeTogether (single crochet three together). 'double crochet three together' is the US name of this concept and the UK name of SingleCrochetThreeTogether (single crochet three together). 'tr3tog' is the UK abbreviation of this concept and the US abbreviation of TrebleCrochetThreeTogether (treble crochet three together). 'treble crochet three together' is the UK name of this concept and the US name of TrebleCrochetThreeTogether."@en-US ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:ExtendedHalfDoubleCrochet a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-ExtendedHalfDoubleCrochet" ;
    dct:source <https://theunraveledmitten.com/2022/01/25/2022-stash-busting-crochet-along/> ;
    dct:subject "hekling"@nb ;
    skos:altLabel "ehtr"@en-GB,
        "ehdc"@en-US ;
    skos:broader vokdata:HalfDoubleCrochet ;
    skos:definition "half double crochet in which one chain is made after the yarn is pulled up, before the yarn is drawn through all three loops on the hook"@en-US,
        "halvstav der det hekles én luftmaske etter at garnet er hentet opp, før garnet trekkes gjennom alle tre løkkene på nålen"@nb ;
    skos:editorialNote "[usikker] nb, de, es: termer ikke verifisert" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "verlängertes halbes Stäbchen"@de,
        "extended half treble crochet"@en-GB,
        "extended half double crochet"@en-US,
        "punto medio alto extendido"@es,
        "forlenget halvstav"@nb ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:ExtendedSingleCrochet a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-ExtendedSingleCrochet" ;
    dct:source <https://theunraveledmitten.com/2022/01/25/2022-stash-busting-crochet-along/> ;
    dct:subject "hekling"@nb ;
    xkos:isPartOf vokdata:BoxedBeadStitch,
        vokdata:PikeStitch ;
    skos:altLabel "edc"@en-GB,
        "esc"@en-US ;
    skos:broader vokdata:SingleCrochet ;
    skos:definition "single crochet in which one chain is made after the yarn is pulled up, before the yarn is drawn through both loops on the hook"@en-US,
        "fastmaske der det hekles én luftmaske etter at garnet er hentet opp, før garnet trekkes gjennom begge løkkene på nålen"@nb ;
    skos:editorialNote "[usikker] nb, de, es: termer ikke verifisert" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "verlängerte feste Masche"@de,
        "extended double crochet"@en-GB,
        "extended single crochet"@en-US,
        "punto bajo extendido"@es,
        "forlenget fastmaske"@nb ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:ForkedCluster a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-ForkedCluster" ;
    dct:source <https://theunraveledmitten.com/2022/07/12/2022-stash-busting-crochet-along-part-6/> ;
    dct:subject "hekling"@nb ;
    xkos:isPartOf vokdata:ForkedClusterStitch ;
    skos:altLabel "FC"@en-US ;
    skos:broader vokdata:Cluster ;
    skos:definition "cluster worked over two stitches in which a yarn over and a loop are pulled up in the same stitch as the last leg of the previous forked cluster and then in the next stitch, after which the loops are closed by drawing the yarn through three loops twice"@en-US,
        "klynge over to masker der det lages ett kast og hentes opp en løkke i samme maske som siste ledd i forrige klynge og deretter i neste maske, før løkkene lukkes ved å trekke garnet gjennom tre løkker to ganger"@nb ;
    skos:editorialNote "Kilden beskriver masken som en variant av dc2tog; [mangler] nb, de, es" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "forked cluster"@en-GB,
        "forked cluster"@en-US ;
    skos:related vokdata:DoubleCrochetTwoTogether ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:FrontPostTrebleCrochet a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-FrontPostTrebleCrochet" ;
    dct:source <https://theunraveledmitten.com/2022/09/06/2022-stash-busting-crochet-along-part-8/> ;
    dct:subject "hekling"@nb ;
    xkos:isPartOf vokdata:AlpineStitch ;
    skos:altLabel "FPdtr"@en-GB,
        "FPtr"@en-US ;
    skos:broader vokdata:PostStitch,
        vokdata:TrebleCrochet ;
    skos:definition "treble crochet worked around the post of a stitch in a lower row, inserting the hook from the front, so that the stitch lies on the front of the work"@en-US,
        "dobbelstav heklet rundt stolpen på en maske i en rad lenger ned med nålen stukket inn forfra, slik at masken legger seg på forsiden av arbeidet"@nb ;
    skos:editorialNote "[usikker] nb; [mangler] de, es" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "front post double treble crochet"@en-GB,
        "front post treble crochet"@en-US,
        "reliefdobbelstav forfra"@nb ;
    skos:related vokdata:FrontPostDoubleCrochet,
        vokdata:FrontPostDoubleTrebleCrochet ;
    skos:scopeNote "Caution: 'FPdtr' is the UK abbreviation of this concept and the US abbreviation of FrontPostDoubleTrebleCrochet (front post double treble crochet). 'FPtr' is the US abbreviation of this concept and the UK abbreviation of FrontPostDoubleCrochet (front post double crochet). 'front post double treble crochet' is the UK name of this concept and the US name of FrontPostDoubleTrebleCrochet. 'front post treble crochet' is the US name of this concept and the UK name of FrontPostDoubleCrochet (front post double crochet)."@en-US ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:HalfDoubleCrochetTwoTogether a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-HalfDoubleCrochetTwoTogether" ;
    dct:source <https://theunraveledmitten.com/2022/01/25/2022-stash-busting-crochet-along/> ;
    dct:subject "hekling"@nb ;
    xkos:isPartOf vokdata:RaisedHerringbone ;
    skos:altLabel "htr2tog"@en-GB,
        "hdc2tog"@en-US ;
    skos:broader vokdata:Stitch ;
    skos:definition "decrease in which two incomplete half double crochets are finished together by drawing the yarn through all loops on the hook at once"@en-US,
        "felling der to ufullførte halvstaver avsluttes sammen ved at garnet trekkes gjennom alle løkkene på nålen i ett trekk"@nb ;
    skos:editorialNote "[usikker] de, es" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "2 halbe Stäbchen zusammen abmaschen"@de,
        "half treble crochet two together"@en-GB,
        "half double crochet two together"@en-US,
        "2 puntos medios altos juntos"@es,
        "2 halvstaver sammen"@nb ;
    skos:related vokdata:Decrease ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:InvisibleDecrease a skos:Concept ;
    svv:tier 2 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-InvisibleDecrease" ;
    dct:subject "hekling"@nb ;
    skos:altLabel "invdec"@en-US ;
    skos:broader vokdata:Decrease ;
    skos:definition "decrease in which two single crochets are worked together through the front loops only, so that the decrease is almost invisible; common in amigurumi"@en-US,
        "felling der to fastmasker hekles sammen gjennom bare de fremre maskeleddene, slik at fellingen blir nesten usynlig; mye brukt i amigurumi"@nb ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "unsichtbare Abnahme"@de,
        "invisible decrease"@en-GB,
        "invisible decrease"@en-US,
        "disminución invisible"@es,
        "usynlig felling"@nb ;
    skos:related vokdata:FrontLoopOnly,
        vokdata:SingleCrochetTwoTogether ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:MagicRing a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-MagicRing" ;
    dct:subject "hekling"@nb ;
    skos:altLabel "magischer Ring"@de,
        "magic circle"@en-GB,
        "MR"@en-US,
        "magic circle"@en-US ;
    skos:definition "adjustable loop of yarn around which the first round is worked and which is then pulled tight to close the centre"@en-US,
        "justerbar løkke av garn som første omgang hekles rundt, og som strammes til slik at midten lukkes"@nb ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "Fadenring"@de,
        "magic ring"@en-GB,
        "magic ring"@en-US,
        "anillo mágico"@es,
        "magisk ring"@nb ;
    skos:related vokdata:Round ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:ReverseSingleCrochet a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-ReverseSingleCrochet" ;
    dct:subject "hekling"@nb ;
    skos:altLabel "reverse double crochet"@en-GB,
        "crab stitch"@en-US,
        "rsc"@en-US,
        "krabbemaske"@nb ;
    skos:broader vokdata:SingleCrochet ;
    skos:definition "single crochet worked backwards, from left to right for right-handed crocheters, producing a corded edge"@en-US,
        "fastmaske heklet baklengs, fra venstre mot høyre for høyrehendte, som gir en snoet kant"@nb ;
    skos:editorialNote "[usikker] nb: «krepsemaske» eller «krabbemaske»" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "Krebsmasche"@de,
        "crab stitch"@en-GB,
        "reverse single crochet"@en-US,
        "punto cangrejo"@es,
        "krepsemaske"@nb ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:SingleCrochetThreeTogether a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-SingleCrochetThreeTogether" ;
    dct:source <https://theunraveledmitten.com/2022/01/25/2022-stash-busting-crochet-along/> ;
    dct:subject "hekling"@nb ;
    xkos:isPartOf vokdata:TrinityStitch,
        vokdata:WaveAndChevron ;
    skos:altLabel "dc3tog"@en-GB,
        "sc3tog"@en-US ;
    skos:broader vokdata:Stitch ;
    skos:definition "decrease in which three incomplete single crochets are finished together by drawing the yarn through all loops on the hook at once"@en-US,
        "felling der tre ufullførte fastmasker avsluttes sammen ved at garnet trekkes gjennom alle løkkene på nålen i ett trekk"@nb ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "3 feste Maschen zusammen abmaschen"@de,
        "double crochet three together"@en-GB,
        "single crochet three together"@en-US,
        "3 puntos bajos juntos"@es,
        "3 fastmasker sammen"@nb ;
    skos:related vokdata:Cluster,
        vokdata:Decrease ;
    skos:scopeNote "Caution: 'dc3tog' is the UK abbreviation of this concept and the US abbreviation of DoubleCrochetThreeTogether (double crochet three together). 'double crochet three together' is the UK name of this concept and the US name of DoubleCrochetThreeTogether."@en-US ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:SlantingCluster a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-SlantingCluster" ;
    dct:source <https://theunraveledmitten.com/2022/09/06/2022-stash-busting-crochet-along-part-8/> ;
    dct:subject "hekling"@nb ;
    xkos:isPartOf vokdata:BoxedBeadStitch ;
    skos:altLabel "slcl"@en-US ;
    skos:broader vokdata:Cluster ;
    skos:definition "cluster worked around the post of the previous double crochet, in which a yarn over and a loop are pulled up three times around the same post, after which the yarn is drawn through six loops and then through the last two"@en-US,
        "klynge heklet rundt stolpen på forrige stav, der det tre ganger lages et kast og hentes opp en løkke rundt samme stolpe, før garnet trekkes gjennom seks løkker og deretter gjennom de to siste"@nb ;
    skos:editorialNote "[mangler] nb, de, es" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "slanting cluster"@en-GB,
        "slanting cluster"@en-US ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:SlipStitch a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-SlipStitch" ;
    dct:subject "hekling"@nb ;
    xkos:isPartOf vokdata:FloretStitch,
        vokdata:Picot ;
    skos:altLabel "Km"@de,
        "ss"@en-GB,
        "sl st"@en-US,
        "pr"@es,
        "punto enano"@es,
        "kjm"@nb ;
    skos:broader vokdata:Stitch ;
    skos:definition "stitch in which the hook is inserted into the work and the yarn is drawn through both the work and the loop on the hook in one movement; adds almost no height"@en-US,
        "maske der nålen stikkes inn i arbeidet og garnet trekkes gjennom både arbeidet og løkken på nålen i ett trekk; gir nesten ingen høyde"@nb ;
    skos:editorialNote "[usikker] es: både «punto raso» og «punto enano» er i bruk; kontroller hva som er vanligst i Spania" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "Kettmasche"@de,
        "slip stitch"@en-GB,
        "slip stitch"@en-US,
        "punto raso"@es,
        "kjedemaske"@nb ;
    skos:related vokdata:Round ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:SpikeStitch a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-SpikeStitch" ;
    dct:subject "hekling"@nb ;
    xkos:isPartOf vokdata:SlantedSpikeStitch ;
    skos:altLabel "elongated single crochet"@en-US ;
    skos:broader vokdata:SingleCrochet ;
    skos:definition "single crochet worked into a stitch one or more rows below, creating a long visible strand across the fabric"@en-US,
        "fastmaske heklet ned i en maske én eller flere rader lenger ned, slik at det dannes en lang, synlig tråd over flaten"@nb ;
    skos:editorialNote "[usikker] nb: «spikemaske»; [mangler] de, es; Kilden (Unraveled Mitten) kaller masken «elongated single crochet».; Kilden (Part 7) har et mønsteravsnitt «Spike Stitch» med fastmasker 1, 2 og 3 rader ned; ikke eget mønsterbegrep" ;
    skos:inScheme <http://example.org/vegvesen/vokabular/crochet-us> ;
    skos:prefLabel "spike stitch"@en-GB,
        "spike stitch"@en-US,
        "spikemaske"@nb ;
    dcat:contactPoint "https://github.com/UteBroenner" .

vokdata:TrebleCrochetThreeTogether a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
