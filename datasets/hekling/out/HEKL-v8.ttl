    skos:altLabel "BPtr"@en-GB,
        "BPdc"@en-US ;
    skos:broader vokdata:DoubleCrochet,
        vokdata:PostStitch ;
    skos:definition "double crochet worked around the post of a stitch in the row below, inserting the hook from the back, so that the stitch lies on the back of the work"@en-US,
        "stav heklet rundt stolpen på en maske i raden under med nålen stukket inn bakfra, slik at masken legger seg på baksiden av arbeidet"@nb ;
