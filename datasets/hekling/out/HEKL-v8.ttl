vokdata:CrossedDoubleCrochet a skos:Concept ;
    svv:tier 1 ;
    euvoc:status concept_status:CANDIDATE ;
    dct:created "2026-11-02"^^xsd:date ;
    dct:identifier "crochet-us-CrossedDoubleCrochet" ;
    dct:subject "hekling"@nb ;
